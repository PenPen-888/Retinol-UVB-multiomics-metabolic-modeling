common_rxns <- intersect(colnames(UA), colnames(UVB))
UA2  <- UA[, common_rxns]
UVB2 <- UVB[, common_rxns]
res_list <- lapply(common_rxns, function(rxn){
  x <- UA2[[rxn]]
  y <- UVB2[[rxn]]
  # Wilcoxon test
  wtest <- wilcox.test(x, y)
  # Cliff's Delta
  cd <- cliff.delta(x, y)
  data.frame(
    ID   = rxn,
    median_UA  = median(x),
    median_UVB = median(y),
    delta_flux = median(x) - median(y),
    pvalue     = wtest$p.value,
    cliffs_delta = cd$estimate
  )
})

res <- do.call(rbind, res_list)
res$FDR <- p.adjust(res$pvalue, method = "BH")
res$effect_size <- cut(abs(res$cliffs_delta),
                       breaks = c(0, 0.147, 0.33, 0.474, 1),
                       labels = c("negligible","small","medium","large"),
                       include.lowest = TRUE)
res$prob_UA_gt_UVB <- (res$cliffs_delta + 1)/2
sig_rxns <- subset(res,
                   FDR < 0.05 &
                   abs(cliffs_delta) > 0.147)
sig_rxns = merge(model_note,sig_rxns)

medium_rxns = subset(res,
                         abs(cliffs_delta) > 0.33)
medium_rxns = merge(model_note,medium_rxns)
write.csv(medium_rxns ,'medium_rxns.csv',row.names = FALSE)
write.csv(sig_rxns ,'sig_rxns.csv',row.names = FALSE)
write.csv(res ,'Cliff_delta_result.csv',row.names = FALSE)
p_volcano = ggplot(res, aes(x = cliffs_delta, y = -log10(FDR))) +
    geom_point(aes(color = effect_size), alpha = 0.7) +
    geom_vline(xintercept = c(-0.147, 0.147), linetype="dashed") +
    labs(x="Cliff's Delta (Effect Size)",y="-log10(FDR)",title = 'HaCaT: UA vs UVB')
    theme_bw(base_size = 14) +
    theme(plot.title = element_text(hjust = 0.5))
ggsave('p_volcano.pdf',p_volcano ,height = 4,width = 4,dpi = 1200)    


